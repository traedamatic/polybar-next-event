# polybar-next-event configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ─────────────────────────────────────────────────

# CalDAV server URL
# Fastmail: https://caldav.fastmail.com/dav/principals/user/YOUR_EMAIL/
CALENDAR_URL=https://caldav.fastmail.com/dav/principals/user/you@fastmail.com/

# CalDAV username (usually your email address)
CALENDAR_USERNAME=you@fastmail.com

# CalDAV password (use an app-specific password, NOT your login password)
# Fastmail: Settings → Privacy & Security → App Passwords → New App Password
CALENDAR_PASSWORD=your-app-password-here

# ── Multiple calendars ───────────────────────────────────────
# To show events from several accounts (e.g. a private and a business
# Fastmail account), use numbered variables instead. Events from all
# accounts are merged and sorted into a single list. If one account fails
# (e.g. wrong password), the others still show.
#
# Each account has its own URL / USERNAME / PASSWORD (required) and an
# optional FILTER. The unnumbered CALENDAR_* vars above still work for a
# single account and, if set, are added as one more account.
#
# CALENDAR_1_URL=https://caldav.fastmail.com/dav/principals/user/private@fastmail.com/
# CALENDAR_1_USERNAME=private@fastmail.com
# CALENDAR_1_PASSWORD=private-app-password
# CALENDAR_1_FILTER=Persönlich
#
# CALENDAR_2_URL=https://caldav.fastmail.com/dav/principals/user/work@fastmail.com/
# CALENDAR_2_USERNAME=work@fastmail.com
# CALENDAR_2_PASSWORD=work-app-password
# CALENDAR_2_FILTER=Work,Team Cal

# ── Optional ─────────────────────────────────────────────────

# Only show events from these calendars (comma-separated display names)
# Leave empty or omit to show all calendars
# For numbered accounts use CALENDAR_1_FILTER, CALENDAR_2_FILTER, etc.
# CALENDAR_FILTER=Persönlich,Tredis (Fam Cal)

# Polling interval in seconds (default: 60)
# POLL_INTERVAL=60

# Urgency colors (hex format, default: Nord theme)
# > 1 hour away (green)
# COLOR_FAR=#A3BE8C
# 15-60 minutes away (yellow)
# COLOR_MEDIUM=#EBCB8B
# < 15 minutes away (red)
# COLOR_URGENT=#BF616A
